<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="164dp"
    android:layout_height="wrap_content"
    android:layout_marginEnd="12dp"
    android:background="@drawable/bg_game_card"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Top info row: App Icon + Title & Detected Pill -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <androidx.cardview.widget.CardView
            android:layout_width="44dp"
            android:layout_height="44dp"
            app:cardBackgroundColor="#0A0F1D"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp">

            <ImageView
                android:id="@+id/ivGameIcon"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="Game Icon"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_lightning_bolt" />
        </androidx.cardview.widget.CardView>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvGameTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-black"
                android:maxLines="1"
                android:text="Subway Surf"
                android:textColor="@color/white"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvDetectedBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_detected_badge"
                android:fontFamily="sans-serif-bold"
                android:paddingHorizontal="7dp"
                android:paddingVertical="2dp"
                android:text="✔ Detected"
                android:textColor="@color/neon_green"
                android:textSize="9.5sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Launch Pill Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnLaunchGame"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_launch_pill"
        android:fontFamily="sans-serif-black"
        android:letterSpacing="0.03"
        android:text="Launch ▶"
        android:textColor="@color/white"
        android:textSize="12sp"
        app:backgroundTint="@null"
        app:cornerRadius="18dp" />

</LinearLayout>
