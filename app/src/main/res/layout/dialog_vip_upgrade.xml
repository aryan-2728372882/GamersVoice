<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:overScrollMode="never"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_glass_card"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Top Header: Crown Icon, Title & Close Button -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_plan_badge_vip">

                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_gravity="center"
                    android:contentDescription="VIP Crown"
                    android:src="@drawable/ic_vip_crown"
                    app:tint="#FFD700" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:letterSpacing="0.05"
                    android:text="GAMERVOICE VIP SQUAD"
                    android:textColor="#FFD700"
                    android:textSize="17sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:fontFamily="sans-serif-bold"
                    android:letterSpacing="0.03"
                    android:text="PRO eSPORTS AUDIO ENGINE"
                    android:textColor="@color/accent_green"
                    android:textSize="10sp" />
            </LinearLayout>

            <ImageView
                android:id="@+id/ivCloseVipDialog"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Close"
                android:padding="6dp"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                app:tint="@color/text_secondary" />
        </LinearLayout>

        <!-- Dynamic Subtitle -->
        <TextView
            android:id="@+id/tvVipSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:lineSpacingExtra="2dp"
            android:text="Dominate Free Fire and BGMI with Studio-Grade AI Noise Filtering, 48kHz HD Audio Turbo and Permanent Squad Rooms."
            android:textColor="#CBD5E0"
            android:textSize="11.5sp" />

        <!-- High-FOMO Flash Drop Banner -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_status_chip"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            android:paddingVertical="7dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:text="🔥 LIMITED SQUAD DROP:"
                android:textColor="#FF2A6D"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/tvFomoCountdown"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:fontFamily="sans-serif-black"
                android:text="⏱️ Ends in 02h : 45m : 18s"
                android:textColor="#FFD700"
                android:textSize="10sp" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="12dp"
            android:background="#1AFFFFFF" />

        <!-- Compelling Feature Breakdown -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Feature 1: Studio Noise Filter -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_shield_check"
                    app:tint="@color/neon_green" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="Studio AI Noise Shield (&lt; 10% Noise, 100% Fan Muted)"
                    android:textColor="@color/white"
                    android:textSize="11.5sp" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginTop="2dp"
                android:text="Cuts motor hum, keyboard clicks &amp; room chatter. Only your voice is broadcast."
                android:textColor="@color/text_secondary"
                android:textSize="10sp" />

            <!-- Feature 2: 48kHz HD Audio Turbo -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_lightning_bolt"
                    app:tint="@color/neon_cyan" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="Zero-Lag 48kHz HD Audio Turbo (64kbps Studio Voice)"
                    android:textColor="@color/white"
                    android:textSize="11.5sp" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginTop="2dp"
                android:text="Crystal-clear audio without robotic voice cuts during heavy firefights."
                android:textColor="@color/text_secondary"
                android:textSize="10sp" />

            <!-- Feature 3: Unlimited Permanent Rooms -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:gravity="center"
                    android:text="♾️"
                    android:textSize="12sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="Unlimited Permanent Squad Rooms (Auto-Saved)"
                    android:textColor="@color/white"
                    android:textSize="11.5sp" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginTop="2dp"
                android:text="Save unlimited tournament &amp; scrim rooms. Rejoin anytime with 0 online."
                android:textColor="@color/text_secondary"
                android:textSize="10sp" />

            <!-- Feature 4: Ad-Free & 0% Game Frame Drop -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:gravity="center"
                    android:text="🛡️"
                    android:textSize="12sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="100% Ad-Free &amp; Zero Frame Drop (&lt; 10MB RAM)"
                    android:textColor="@color/white"
                    android:textSize="11.5sp" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginTop="2dp"
                android:text="Buttery 90/120 FPS in Free Fire / BGMI with zero intrusive ads."
                android:textColor="@color/text_secondary"
                android:textSize="10sp" />

            <!-- Feature 5: PIN Lock & VIP Crown -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:gravity="center"
                    android:text="🔒"
                    android:textSize="12sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="Private PIN Locks &amp; Golden VIP Crown Nameplate"
                    android:textColor="@color/white"
                    android:textSize="11.5sp" />
            </LinearLayout>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="14dp"
            android:background="#1AFFFFFF" />

        <!-- 3 Pricing Cards (Weekly, Monthly Pro, Lifetime) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <!-- Card 1: Weekly (7 Days) -->
            <LinearLayout
                android:id="@+id/llPlanWeekly"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:background="@drawable/bg_vip_card_unselected"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:text="7 DAYS"
                    android:textColor="@color/text_secondary"
                    android:textSize="10sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:fontFamily="sans-serif-black"
                    android:text="₹29"
                    android:textColor="@color/white"
                    android:textSize="16sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="₹4 / Day"
                    android:textColor="@color/text_secondary"
                    android:textSize="9.5sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Weekend Pass"
                    android:textColor="@color/accent_green"
                    android:textSize="8.5sp" />
            </LinearLayout>

            <!-- Card 2: Monthly Pro (30 Days) - MOST POPULAR -->
            <LinearLayout
                android:id="@+id/llPlanMonthly"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.2"
                android:background="@drawable/bg_vip_card_gold"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_popular_badge"
                    android:fontFamily="sans-serif-black"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="1dp"
                    android:text="⭐ 55% OFF"
                    android:textColor="@color/black"
                    android:textSize="8sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:fontFamily="sans-serif-black"
                    android:text="30 DAYS"
                    android:textColor="#FFD700"
                    android:textSize="10sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="sans-serif-black"
                    android:text="₹89"
                    android:textColor="@color/white"
                    android:textSize="18sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="was ₹199"
                    android:textColor="@color/text_secondary"
                    android:textSize="9.5sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:fontFamily="sans-serif-bold"
                    android:text="🔥 MOST POPULAR"
                    android:textColor="#FFD700"
                    android:textSize="8.5sp" />
            </LinearLayout>

            <!-- Card 3: Lifetime Legend Pass -->
            <LinearLayout
                android:id="@+id/llPlanLifetime"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:background="@drawable/bg_vip_card_unselected"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_fomo_badge"
                    android:fontFamily="sans-serif-black"
                    android:paddingHorizontal="5dp"
                    android:paddingVertical="1dp"
                    android:text="⚡ 75% OFF"
                    android:textColor="@color/white"
                    android:textSize="8sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:fontFamily="sans-serif-black"
                    android:text="LIFETIME"
                    android:textColor="@color/text_secondary"
                    android:textSize="10sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="sans-serif-black"
                    android:text="₹249"
                    android:textColor="@color/white"
                    android:textSize="16sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="was ₹999"
                    android:textColor="@color/text_secondary"
                    android:textSize="9.5sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Never Expire"
                    android:textColor="@color/neon_cyan"
                    android:textSize="8.5sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Dynamic Razorpay Checkout CTA Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnActivateVip"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_cyber_button_gold"
            android:fontFamily="sans-serif-black"
            android:letterSpacing="0.03"
            android:text="⚡ UNLOCK 30 DAYS VIP — ₹89"
            android:textColor="@color/black"
            android:textSize="13sp"
            app:backgroundTint="@null"
            app:cornerRadius="14dp" />

        <!-- Trust & Payment Method Logos -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="🔒 Secured by Razorpay • UPI / GPay / PhonePe / Paytm / Cards"
                android:textColor="@color/text_secondary"
                android:textSize="9.5sp" />
        </LinearLayout>

        <!-- Collapsible / Discreet Admin & Test Controls -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnResetToFree"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="sans-serif-bold"
                android:padding="6dp"
                android:text="🔄 Revoke / Reset Plan to Free"
                android:textColor="#FF2A6D"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- Hidden legacy buttons for compatibility with existing tests if needed -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone">

            <Button android:id="@+id/btnTestWeekly" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <Button android:id="@+id/btnTestMonthly" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <Button android:id="@+id/btnTestLifetime" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <Button android:id="@+id/btnTestExpire" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
