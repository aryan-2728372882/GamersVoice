<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/primary_dark"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp">

        <!-- App Logo & Branding -->
        <ImageView
            android:id="@+id/ivAuthLogo"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginTop="16dp"
            android:contentDescription="@string/app_name"
            android:src="@drawable/ic_app_logo_hero"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvAuthTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="sans-serif-black"
            android:text="@string/app_name"
            android:textColor="@color/accent_green"
            android:textSize="24sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/ivAuthLogo" />

        <TextView
            android:id="@+id/tvAuthSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="sans-serif-medium"
            android:text="Ultra-Low Latency Squad Voice Chat"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvAuthTitle" />

        <!-- Tab Selector: Sign In vs Sign Up -->
        <LinearLayout
            android:id="@+id/llAuthTabs"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_terminal_box"
            android:orientation="horizontal"
            android:padding="3dp"
            app:layout_constraintTop_toBottomOf="@id/tvAuthSubtitle">

            <Button
                android:id="@+id/tabSignIn"
                style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:backgroundTint="@color/accent_green"
                android:fontFamily="sans-serif-black"
                android:text="SIGN IN"
                android:textColor="@color/black"
                android:textSize="12sp"
                app:cornerRadius="6dp" />

            <Button
                android:id="@+id/tabSignUp"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:fontFamily="sans-serif-black"
                android:text="CREATE ACCOUNT"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                app:cornerRadius="6dp" />
        </LinearLayout>

        <!-- Form Container -->
        <LinearLayout
            android:id="@+id/llAuthForm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="vertical"
            app:layout_constraintTop_toBottomOf="@id/llAuthTabs">

            <!-- Full Name (Sign Up only) -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilName"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:hint="Gamer / In-Game Name"
                android:textColorHint="@color/text_secondary"
                android:visibility="gone"
                app:boxStrokeColor="@color/accent_green"
                app:hintTextColor="@color/accent_green"
                tools:visibility="visible">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:inputType="textPersonName"
                    android:textColor="@color/white"
                    android:textSize="14sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Email Address -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilEmail"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:hint="Email Address"
                android:textColorHint="@color/text_secondary"
                app:boxStrokeColor="@color/accent_green"
                app:hintTextColor="@color/accent_green">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etEmail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:inputType="textEmailAddress"
                    android:textColor="@color/white"
                    android:textSize="14sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Phone Number (Sign Up only) -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilPhone"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:hint="Phone Number"
                android:textColorHint="@color/text_secondary"
                android:visibility="gone"
                app:boxStrokeColor="@color/accent_green"
                app:hintTextColor="@color/accent_green"
                tools:visibility="visible">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etPhone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:inputType="phone"
                    android:textColor="@color/white"
                    android:textSize="14sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Password -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilPassword"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:hint="Password (min 6 chars)"
                android:textColorHint="@color/text_secondary"
                app:boxStrokeColor="@color/accent_green"
                app:hintTextColor="@color/accent_green"
                app:passwordToggleEnabled="true"
                app:passwordToggleTint="@color/text_secondary">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etPassword"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:inputType="textPassword"
                    android:textColor="@color/white"
                    android:textSize="14sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Avatar Picker Section (Sign Up only) -->
            <LinearLayout
                android:id="@+id/llAvatarSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="visible">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:fontFamily="sans-serif-black"
                    android:text="SELECT GAMER AVATAR"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/ivAvatar1"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_margin="6dp"
                        android:background="@drawable/bg_code_input"
                        android:contentDescription="Avatar 1"
                        android:padding="2dp"
                        android:src="@drawable/ic_avatar_1" />

                    <ImageView
                        android:id="@+id/ivAvatar2"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_margin="6dp"
                        android:contentDescription="Avatar 2"
                        android:padding="2dp"
                        android:src="@drawable/ic_avatar_2" />

                    <ImageView
                        android:id="@+id/ivAvatar3"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_margin="6dp"
                        android:contentDescription="Avatar 3"
                        android:padding="2dp"
                        android:src="@drawable/ic_avatar_3" />

                    <ImageView
                        android:id="@+id/ivAvatar4"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_margin="6dp"
                        android:contentDescription="Avatar 4"
                        android:padding="2dp"
                        android:src="@drawable/ic_avatar_4" />

                    <ImageView
                        android:id="@+id/ivAvatar5"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_margin="6dp"
                        android:contentDescription="Avatar 5"
                        android:padding="2dp"
                        android:src="@drawable/ic_avatar_5" />
                </LinearLayout>
            </LinearLayout>

            <!-- Error Banner -->
            <TextView
                android:id="@+id/tvAuthError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:background="#2A1515"
                android:fontFamily="sans-serif-medium"
                android:padding="8dp"
                android:textColor="#FF5252"
                android:textSize="12sp"
                android:visibility="gone"
                tools:text="Error message here" />

            <!-- Submit Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSubmitAuth"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:backgroundTint="@color/accent_green"
                android:fontFamily="sans-serif-black"
                android:text="SIGN IN"
                android:textColor="@color/black"
                android:textSize="14sp"
                app:cornerRadius="8dp" />

            <!-- OR Divider -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginVertical="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:background="#26FFFFFF" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="12dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="OR"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:background="#26FFFFFF" />
            </LinearLayout>

            <!-- Sign in with Google Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnGoogleSignIn"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:fontFamily="sans-serif-black"
                android:text="Continue with Google"
                android:textColor="@color/white"
                android:textSize="14sp"
                app:cornerRadius="8dp"
                app:icon="@drawable/ic_google_logo"
                app:iconGravity="textStart"
                app:iconPadding="12dp"
                app:iconTint="@null"
                app:strokeColor="#40FFFFFF"
                app:strokeWidth="1dp" />

            <!-- Progress Indicator -->
            <ProgressBar
                android:id="@+id/pbAuthLoading"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center"
                android:layout_marginTop="12dp"
                android:indeterminateTint="@color/accent_green"
                android:visibility="gone" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
