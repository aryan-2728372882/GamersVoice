<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#06080E"
    android:fadeScrollbars="false"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20dp"
        android:paddingVertical="24dp">

        <!-- Top Tactical Status Chip -->
        <LinearLayout
            android:id="@+id/llAuthBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_top_profile_bar"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="14dp"
            android:paddingVertical="6dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <View
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="@drawable/bg_status_chip"
                android:backgroundTint="@color/neon_green" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="0.08"
                android:text="ESPORTS ACCESS PORTAL • 2026 PROTOCOL"
                android:textColor="@color/neon_green"
                android:textSize="9sp" />
        </LinearLayout>

        <!-- Glowing Hero Logo Emblem -->
        <FrameLayout
            android:id="@+id/flAuthLogoRing"
            android:layout_width="104dp"
            android:layout_height="104dp"
            android:layout_marginTop="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/llAuthBadge">

            <ImageView
                android:id="@+id/ivAuthLogo"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/app_name"
                android:src="@drawable/app_logo" />
        </FrameLayout>

        <!-- Brand Name -->
        <TextView
            android:id="@+id/tvAuthTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="sans-serif-black"
            android:letterSpacing="0.12"
            android:text="GAMERVOICE"
            android:textColor="@color/white"
            android:textSize="26sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/flAuthLogoRing" />

        <!-- Subtitle -->
        <TextView
            android:id="@+id/tvAuthSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:fontFamily="sans-serif-medium"
            android:text="Ultra-Low Latency Squad Audio Engine"
            android:textColor="#94A3B8"
            android:textSize="12.5sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvAuthTitle" />

        <!-- 3 Feature Highlights Pill Strip -->
        <LinearLayout
            android:id="@+id/llPillStrip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:orientation="horizontal"
            app:layout_constraintTop_toBottomOf="@id/tvAuthSubtitle">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_top_profile_bar"
                android:fontFamily="sans-serif-black"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="⚡ 48kHz OPUS"
                android:textColor="@color/accent_green"
                android:textSize="9.5sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_top_profile_bar"
                android:fontFamily="sans-serif-black"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="🔒 E2E ENCRYPTED"
                android:textColor="@color/neon_cyan"
                android:textSize="9.5sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_top_profile_bar"
                android:fontFamily="sans-serif-black"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="🛡️ ZERO LOGS"
                android:textColor="#CBD5E1"
                android:textSize="9.5sp" />
        </LinearLayout>

        <!-- Tab Selector: Sign In vs Sign Up -->
        <LinearLayout
            android:id="@+id/llAuthTabs"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_top_profile_bar"
            android:orientation="horizontal"
            android:padding="4dp"
            app:layout_constraintTop_toBottomOf="@id/llPillStrip">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/tabSignIn"
                style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:backgroundTint="@color/accent_green"
                android:fontFamily="sans-serif-black"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:letterSpacing="0.04"
                android:text="SIGN IN"
                android:textColor="@color/black"
                android:textSize="12sp"
                app:cornerRadius="12dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/tabSignUp"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:fontFamily="sans-serif-black"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:letterSpacing="0.04"
                android:text="CREATE ACCOUNT"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                app:cornerRadius="12dp" />
        </LinearLayout>

        <!-- Form Container -->
        <LinearLayout
            android:id="@+id/llAuthForm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="vertical"
            app:layout_constraintTop_toBottomOf="@id/llAuthTabs">

            <!-- Full Name (Sign Up only) -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilName"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:hint="Gamer / In-Game Name"
                android:textColorHint="#64748B"
                android:visibility="gone"
                app:boxBackgroundColor="#0B101D"
                app:boxCornerRadiusBottomEnd="12dp"
                app:boxCornerRadiusBottomStart="12dp"
                app:boxCornerRadiusTopEnd="12dp"
                app:boxCornerRadiusTopStart="12dp"
                app:boxStrokeColor="@color/accent_green"
                app:boxStrokeWidth="1.2dp"
                app:boxStrokeWidthFocused="1.8dp"
                app:hintTextColor="@color/accent_green"
                tools:visibility="visible">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:inputType="textPersonName"
                    android:textColor="@color/white"
                    android:textSize="14sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Email Address -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilEmail"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:hint="Email Address"
                android:textColorHint="#64748B"
                app:boxBackgroundColor="#0B101D"
                app:boxCornerRadiusBottomEnd="12dp"
                app:boxCornerRadiusBottomStart="12dp"
                app:boxCornerRadiusTopEnd="12dp"
                app:boxCornerRadiusTopStart="12dp"
                app:boxStrokeColor="@color/accent_green"
                app:boxStrokeWidth="1.2dp"
                app:boxStrokeWidthFocused="1.8dp"
                app:hintTextColor="@color/accent_green">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etEmail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:inputType="textEmailAddress"
                    android:textColor="@color/white"
                    android:textSize="14sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Phone Number (Sign Up only) -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilPhone"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:hint="Phone Number"
                android:textColorHint="#64748B"
                android:visibility="gone"
                app:boxBackgroundColor="#0B101D"
                app:boxCornerRadiusBottomEnd="12dp"
                app:boxCornerRadiusBottomStart="12dp"
                app:boxCornerRadiusTopEnd="12dp"
                app:boxCornerRadiusTopStart="12dp"
                app:boxStrokeColor="@color/accent_green"
                app:boxStrokeWidth="1.2dp"
                app:boxStrokeWidthFocused="1.8dp"
                app:hintTextColor="@color/accent_green"
                tools:visibility="visible">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etPhone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:inputType="phone"
                    android:textColor="@color/white"
                    android:textSize="14sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Password -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilPassword"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:hint="Password (min 6 chars)"
                android:textColorHint="#64748B"
                app:boxBackgroundColor="#0B101D"
                app:boxCornerRadiusBottomEnd="12dp"
                app:boxCornerRadiusBottomStart="12dp"
                app:boxCornerRadiusTopEnd="12dp"
                app:boxCornerRadiusTopStart="12dp"
                app:boxStrokeColor="@color/accent_green"
                app:boxStrokeWidth="1.2dp"
                app:boxStrokeWidthFocused="1.8dp"
                app:hintTextColor="@color/accent_green"
                app:passwordToggleEnabled="true"
                app:passwordToggleTint="@color/text_secondary">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etPassword"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:inputType="textPassword"
                    android:textColor="@color/white"
                    android:textSize="14sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Avatar Picker Section (Sign Up only) -->
            <LinearLayout
                android:id="@+id/llAvatarSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_top_profile_bar"
                android:orientation="vertical"
                android:padding="14dp"
                android:visibility="gone"
                tools:visibility="visible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-black"
                        android:letterSpacing="0.06"
                        android:text="SELECT SQUAD AVATAR"
                        android:textColor="@color/white"
                        android:textSize="11.5sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:fontFamily="sans-serif-bold"
                        android:text="• TACTICAL RIG"
                        android:textColor="@color/accent_green"
                        android:textSize="10sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/ivAvatar1"
                        android:layout_width="50dp"
                        android:layout_height="50dp"
                        android:layout_margin="5dp"
                        android:background="@drawable/bg_avatar_ring"
                        android:contentDescription="Avatar 1"
                        android:padding="3dp"
                        android:src="@drawable/ic_avatar_1" />

                    <ImageView
                        android:id="@+id/ivAvatar2"
                        android:layout_width="50dp"
                        android:layout_height="50dp"
                        android:layout_margin="5dp"
                        android:contentDescription="Avatar 2"
                        android:padding="3dp"
                        android:src="@drawable/ic_avatar_2" />

                    <ImageView
                        android:id="@+id/ivAvatar3"
                        android:layout_width="50dp"
                        android:layout_height="50dp"
                        android:layout_margin="5dp"
                        android:contentDescription="Avatar 3"
                        android:padding="3dp"
                        android:src="@drawable/ic_avatar_3" />

                    <ImageView
                        android:id="@+id/ivAvatar4"
                        android:layout_width="50dp"
                        android:layout_height="50dp"
                        android:layout_margin="5dp"
                        android:contentDescription="Avatar 4"
                        android:padding="3dp"
                        android:src="@drawable/ic_avatar_4" />

                    <ImageView
                        android:id="@+id/ivAvatar5"
                        android:layout_width="50dp"
                        android:layout_height="50dp"
                        android:layout_margin="5dp"
                        android:contentDescription="Avatar 5"
                        android:padding="3dp"
                        android:src="@drawable/ic_avatar_5" />
                </LinearLayout>
            </LinearLayout>

            <!-- Error Banner -->
            <TextView
                android:id="@+id/tvAuthError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:background="@drawable/bg_terminal_box"
                android:backgroundTint="#2D1115"
                android:fontFamily="sans-serif-medium"
                android:padding="12dp"
                android:textColor="#FF6B6B"
                android:textSize="12.5sp"
                android:visibility="gone"
                tools:text="Error message here" />

            <!-- Submit Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSubmitAuth"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:backgroundTint="@color/neon_green"
                android:elevation="6dp"
                android:fontFamily="sans-serif-black"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:letterSpacing="0.05"
                android:text="SIGN IN ⚡"
                android:textColor="@color/black"
                android:textSize="14sp"
                app:cornerRadius="14dp"
                app:rippleColor="#40000000" />

            <!-- OR Divider -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginVertical="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:background="#1E2A42" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="14dp"
                    android:fontFamily="sans-serif-black"
                    android:letterSpacing="0.08"
                    android:text="OR CONTINUE WITH"
                    android:textColor="#64748B"
                    android:textSize="10sp" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:background="#1E2A42" />
            </LinearLayout>

            <!-- Sign in with Google Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnGoogleSignIn"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:backgroundTint="#0D1322"
                android:fontFamily="sans-serif-bold"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:letterSpacing="0.02"
                android:text="Continue with Google"
                android:textColor="@color/white"
                android:textSize="13.5sp"
                app:cornerRadius="14dp"
                app:icon="@drawable/ic_google_logo"
                app:iconGravity="textStart"
                app:iconPadding="12dp"
                app:iconTint="@null"
                app:strokeColor="#223048"
                app:strokeWidth="1.2dp" />

            <!-- Progress Indicator -->
            <ProgressBar
                android:id="@+id/pbAuthLoading"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center"
                android:layout_marginTop="14dp"
                android:indeterminateTint="@color/accent_green"
                android:visibility="gone" />

            <!-- Security & Compliance Trust Badge -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="20dp"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="🛡️ Indian DPDP Act 2023 Compliant • Zero Cloud Voice Logs"
                    android:textColor="#64748B"
                    android:textSize="10.5sp" />
            </LinearLayout>

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
