<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_terminal_box"
    android:orientation="vertical"
    android:padding="22dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/ivNoiseDialogIcon"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:contentDescription="GamerVoice Emblem"
            android:src="@drawable/app_logo_small" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:text="AI NOISE REDUCTION"
                android:textColor="@color/white"
                android:textSize="16sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="Real-time WebRTC Opus Acoustic DSP"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/btnCloseNoiseDialog"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="Close"
            android:focusable="true"
            android:padding="4dp"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            app:tint="@color/text_secondary" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="16dp"
        android:background="#1AFFFFFF" />

    <!-- Current Percentage Hero Box -->
    <LinearLayout
        android:id="@+id/llNoiseHeroBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_vip_card_neon"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/tvNoisePercentHero"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-black"
            android:textColor="@color/neon_green"
            android:textSize="36sp"
            tools:text="50%" />

        <TextView
            android:id="@+id/tvNoiseTierLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="sans-serif-bold"
            android:textColor="@color/white"
            android:textSize="13sp"
            tools:text="Standard Mic Filter (Balanced)" />

        <TextView
            android:id="@+id/tvNoiseDescription"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            tools:text="Filters keyboard clicks and room resonance while keeping natural team voice." />
    </LinearLayout>

    <!-- Slider Container -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:fontFamily="sans-serif-bold"
        android:text="SUPPRESSION LEVEL"
        android:textColor="@color/text_secondary"
        android:textSize="10.5sp" />

    <com.google.android.material.slider.Slider
        android:id="@+id/sliderNoiseLevel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:stepSize="25"
        android:value="50"
        android:valueFrom="0"
        android:valueTo="100"
        app:haloColor="#3300FF88"
        app:thumbColor="@color/accent_green"
        app:thumbRadius="10dp"
        app:trackColorActive="@color/accent_green"
        app:trackColorInactive="#22FFFFFF"
        app:trackHeight="6dp" />

    <!-- Slider Markers -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="start"
            android:text="0%\n(Off)"
            android:textColor="@color/text_secondary"
            android:textSize="9.5sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="50%\n(Standard)"
            android:textColor="@color/white"
            android:textSize="9.5sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end"
            android:text="100% 👑\n(Ultra Silent)"
            android:textColor="@color/neon_gold"
            android:textSize="9.5sp" />
    </LinearLayout>

    <!-- VIP Banner if locked -->
    <LinearLayout
        android:id="@+id/llVipLockWarning"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_vip_card_gold"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="10dp"
        android:visibility="gone"
        tools:visibility="visible">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="👑"
            android:textSize="18sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:text="100% Ultra Silent AI Shield is locked to VIP members. Upgrade to unlock full studio silence."
            android:textColor="@color/white"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnApplyNoiseSetting"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_cyber_button_gold"
            android:fontFamily="sans-serif-black"
            android:text="APPLY FILTER"
            android:textColor="@color/cyber_black"
            android:textSize="13sp" />
    </LinearLayout>
</LinearLayout>
